  },
  "item": [
    {
      "name": "1. service-vuelos (Puerto 8082 - Rol Socio)",
      "item": [
        {
          "name": "Listar todos los vuelos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8082/api/vuelos",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "vuelos"]
            }
          }
        },
        {
          "name": "Listar vuelos por fecha (fin de semana/festivo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8082/api/vuelos/fecha/2026-11-21",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "vuelos", "fecha", "2026-11-21"]
            }
          }
        },
        {
          "name": "Crear reserva completa (Socio Formador)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pasajero\": \"Álvaro Ramírez Soto\",\n  \"rut\": \"18.452.310-K\",\n  \"oficinaBanco\": \"Casa Matriz Alameda\",\n  \"esSocio\": true,\n  \"telefonoMovil\": \"+56987654321\",\n  \"cantidadPasajeros\": 3,\n  \"fecha\": \"2026-11-21\",\n  \"bloqueHorario\": \"10:00 - 11:00\",\n  \"aeronave\": \"CC-AAA Cessna 172\",\n  \"plazasAeronave\": 4,\n  \"baseAerea\": \"Tobalaba\",\n  \"destino\": \"Circuito Precordillera Santiago (SCTB)\"\n}"
            },
            "url": {
